ENVIRONMENT=development
DEBUG=true
APP_TITLE=FastAPI Template
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

POSTGRES_USER=app
POSTGRES_PASSWORD=<set-database-password>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app

# CELERY SETTINGS
CELERY_APP_MAIN=email-service
CELERY_APP_BROKER=redis://:<set-redis-password>@redis:6379/1
CELERY_APP_BACKEND=redis://:<set-redis-password>@redis:6379/2

# REDIS
REDIS_PASSWORD=<set-redis-password>

# SMTP SETTINGS
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=<set-smtp-password>
SMTP_USE_TLS=
EMAIL_FROM=

# MAIN BACKEND SERVICE
MAIN_BACKEND_URL=http://localhost:8000
MAIN_BACKEND_SERVICE_KEY=<generate-a-random-service-key>
