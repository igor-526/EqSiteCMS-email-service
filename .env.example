ENVIRONMENT=development
DEBUG=true
APP_TITLE=FastAPI Template
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

POSTGRES_USER=app
POSTGRES_PASSWORD=<set-database-password>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app

# CELERY SETTINGS
CELERY_APP_MAIN=email-service
CELERY_APP_BROKER=redis://:<set-redis-password>@redis:6379/1
CELERY_APP_BACKEND=redis://:<set-redis-password>@redis:6379/2

# REDIS
REDIS_PASSWORD=<set-redis-password>

# SMTP SETTINGS: choose the explicit mode; remove legacy variable entirely.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=<set-smtp-user>
SMTP_PASSWORD=<set-smtp-password>
EMAIL_FROM=sender@example.invalid
# Selectel implicit TLS: SMTP_HOST=smtp.mail.selcloud.ru, SMTP_PORT=1127, SMTP_TLS_MODE=tls
# Selectel mandatory STARTTLS: SMTP_HOST=smtp.mail.selcloud.ru, SMTP_PORT=1126, SMTP_TLS_MODE=starttls
# Standard implicit TLS: SMTP_PORT=465, SMTP_TLS_MODE=tls
# Plaintext ONLY for a trusted local SMTP: SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_TLS_MODE=none
# Never use plaintext to work around TLS errors. See README for migration and G1..G4 live permits.

# MAIN BACKEND SERVICE
MAIN_BACKEND_URL=http://localhost:8000
MAIN_BACKEND_SERVICE_KEY=<generate-a-random-service-key>
